# Supabase project settings → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Settings → API → service_role key. Server-only — never expose to the
# browser. Required at runtime (not just for `npm run seed`): submitAttempt
# reads memo_answers through a service-role client, since that table is
# intentionally not readable by the student's own session (see
# src/lib/supabase/service.ts).
SUPABASE_SERVICE_ROLE_KEY=
