# Supabase project settings → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Settings → API → service_role key. Server-only — never expose to the
# browser. Required at runtime (not just for `npm run seed`): submitAttempt
# reads memo_answers through a service-role client, since that table is
# intentionally not readable by the student's own session (see
# src/lib/supabase/service.ts).
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Free key from aistudio.google.com → Get API key. Without this,
# free-text answers are marked by the deterministic keyword grader
# (src/lib/grader.ts). Set this to switch to AI marking via Gemini's free
# tier (better quality, no per-request cost) — no other change needed,
# submitAttempt picks it up automatically. Note: on the free tier, Google
# may use submitted content to improve their models — worth knowing since
# this sends real exam answers.
GEMINI_API_KEY=
