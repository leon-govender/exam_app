# Supabase project settings → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Settings → API → service_role key. Server-only — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. console.anthropic.com → API Keys. Without this, answers are
# marked by the free rule-based grader (src/lib/grader.ts). Set this to
# switch to AI marking (better quality, small per-paper cost) — no other
# change needed, submitAttempt picks it up automatically.
ANTHROPIC_API_KEY=
